# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public hostname, e.g. signlearn.duckdns.org
DOMAIN=
# Let's Encrypt expiry notices go here.
LETSENCRYPT_EMAIL=

# Long random values: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# DuckDNS keeps DOMAIN pointing at the VM when its public IP changes.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
