DATABASE_URL=postgresql+asyncpg://sign:sign@postgres:5432/sign
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
JWT_TTL_MIN=60
MODEL_PATH=ml/artifacts/model-v1.joblib
CONFIDENCE_THRESHOLD=0.7
HOLD_FRAMES=10
MAX_FPS_PER_CONN=30
# Local development only. Accepts any token on /ws/practice; never set on a
# deployed instance. Off means the socket is closed until JWT auth lands.
DEV_AUTH=true
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# ml scripts only
BUKVA_DIR=
